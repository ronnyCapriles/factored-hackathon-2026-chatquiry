# Copy to .env; docker compose reads it for the dev stack.
AWS_PROFILE=default
AWS_REGION=us-east-1
# TypeSafe key for the Jev intake classifier; leave empty to use the keyword rules.
TYPESAFE_API_KEY=
# Outputs of infra/prod/guardrail; leave empty to run without the guardrail.
GUARDRAIL_ID=
GUARDRAIL_VERSION=
# Written by `cq-eval setup`: the evaluation bank's public key on one line.
CUSTOMER_ASSERTION_PUBLIC_KEY=
# The harness's API key: docker compose exec api python -m app.keys --name Evaluation
EVAL_API_KEY=
