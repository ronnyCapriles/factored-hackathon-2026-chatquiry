# Copy to .env.datathon. Read-only credentials the organizers hand out for the dataset bucket; they are not this
# project's AWS account and nothing in the app reads them. Only used to download the dataset into data/bronze:
#   set -a; . ./.env.datathon; set +a
#   aws s3 sync "s3://$DATATHON_BUCKET/data/" data/bronze/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
DATATHON_BUCKET=
